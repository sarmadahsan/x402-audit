# ---- x402-audit environment ------------------------------------------------
# Copy to .env (gitignored). Never commit real values. Every variable is listed.

# Database file (created on first use).
X402_AUDIT_DB=data/audit.sqlite

# Network. Default is Base Sepolia. Mainnet additionally requires --live on the
# command line AND X402_AUDIT_LIVE=1 AND --network eip155:8453.
X402_AUDIT_NETWORK=eip155:84532
X402_AUDIT_LIVE=0

# RPC endpoints (HTTPS). Public endpoints work for probing; buying and chain
# scanning want a provider key because of eth_getLogs limits.
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Used for eth_getLogs scans (volume ranking, settlement confirmation, chain module).
# mainnet.base.org returns 429 for getLogs; publicnode allows 50k-block spans without a key.
BASE_LOGS_RPC_URL=https://base-rpc.publicnode.com

# Buyer wallet pool: comma-separated hex private keys, funded MANUALLY with
# USDC (no ETH needed for EIP-3009 settlement). The harness never funds them.
# Example (DO NOT USE): 0xabc...,0xdef...
X402_AUDIT_WALLET_KEYS=

# Hard caps in USD (USDC at 1:1). Enforced before any signature.
MAX_PER_CALL_USD=0.50
MAX_PER_SELLER_PER_DAY_USD=20
MAX_PER_DAY_USD=100
MAX_TOTAL_USD=300

# Stress module has its own caps.
STRESS_MAX_TOTAL_USD=30

# Coinbase CDP API credentials, only if the Bazaar discovery endpoint needs them
# (see docs/protocol-notes.md). Leave empty to use the public facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# x402scan API key, if it ever requires one (currently documented in notes).
X402SCAN_API_KEY=

# Telemetry ingest (module 6).
TELEMETRY_BIND=127.0.0.1:8787
TELEMETRY_INGEST_TOKEN=

# Log level: error | warn | info | debug. Keys are never logged at any level.
LOG_LEVEL=info

# ---- Audits and candidates (docs/PLAN.md "Audits", "Candidates", "Schedule") ----
# Audit purchases spend only when this is 1, on top of --live and X402_AUDIT_LIVE=1. Off by default.
AUDIT_TRIGGERS_ENABLED=0
# Purchases from user-imported candidate sellers happen only when this is 1. Off by default.
CANDIDATE_BUYS_ENABLED=0
# Audit caps: per UTC day over the audit sources, sellers per day, calls per seller. The per-call cap is MAX_PER_CALL_USD.
AUDIT_MAX_PER_DAY_USD=5
AUDIT_MAX_SELLERS_PER_DAY=10
AUDIT_MAX_CALLS_PER_SELLER=10
# The public index the triggers read and audits post to.
PAIDFOR_INDEX_URL=https://paidfor.dev
# Shared secret for POST /v1/audits (docs/audit-callback.md); empty = results are stored, not posted.
AUDIT_SECRET=
