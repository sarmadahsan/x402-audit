# x402-audit environment. Copy to .env (gitignored) and fill in only what you need.
# No values here: every variable has a default in src/config/index.ts or scripts/loop.sh, given in the comment.

# ---- Core ----
# SQLite file every command reads and writes (default data/audit.sqlite).
X402_AUDIT_DB=
# Network id: eip155:84532 (Base Sepolia, default) or eip155:8453 (Base mainnet).
X402_AUDIT_NETWORK=
# Must be 1, together with --live and --network eip155:8453, before any mainnet payment (default 0).
X402_AUDIT_LIVE=
# Log level: error, warn, info or debug (default info). Keys are never logged.
LOG_LEVEL=

# ---- RPC ----
# Base mainnet RPC for receipts and balances (default https://mainnet.base.org).
BASE_RPC_URL=
# Base Sepolia RPC (default https://sepolia.base.org).
BASE_SEPOLIA_RPC_URL=
# RPC used for eth_getLogs scans; must allow wide block spans (default https://base-rpc.publicnode.com).
BASE_LOGS_RPC_URL=

# ---- Wallets ----
# Comma-separated buyer private keys, funded manually with USDC. Never commit. Empty = no signing.
X402_AUDIT_WALLET_KEYS=

# ---- Caps (USD, USDC at 1:1), enforced in code before any signature ----
# Per paid call (default 0.50).
MAX_PER_CALL_USD=
# Per seller per UTC day (default 20).
MAX_PER_SELLER_PER_DAY_USD=
# Per UTC day across all sources (default 100).
MAX_PER_DAY_USD=
# Lifetime total for the database (default 300).
MAX_TOTAL_USD=
# Lifetime total for the stress module (default 30).
STRESS_MAX_TOTAL_USD=

# ---- Optional API credentials ----
# Coinbase CDP key id, only if the Bazaar discovery endpoint ever requires one (unused today).
CDP_API_KEY_ID=
# Coinbase CDP key secret, as above.
CDP_API_KEY_SECRET=
# x402scan API key, if it ever requires one (unused today).
X402SCAN_API_KEY=

# ---- Telemetry ingest (module 6) ----
# Address the ingest server binds to (default 127.0.0.1:8787).
TELEMETRY_BIND=
# Bearer token clients must send to the ingest server; empty = no token required.
TELEMETRY_INGEST_TOKEN=
# Client-side opt-out read by @x402-audit/client: off, 0, false, no or disabled.
X402_AUDIT_TELEMETRY=

# ---- Index, audits and candidates (docs/PLAN.md, docs/audit-callback.md) ----
# Public index the triggers read and audit results post to (default https://paidfor.dev).
PAIDFOR_INDEX_URL=
# Shared secret that signs audit and health posts to the index; empty = results are stored, not posted.
AUDIT_SECRET=
# 1 = audit purchases may spend, on top of the live gate (default 0).
AUDIT_TRIGGERS_ENABLED=
# 1 = queued candidate sellers may be bought (default 0).
CANDIDATE_BUYS_ENABLED=
# Audit spend per UTC day (default 5).
AUDIT_MAX_PER_DAY_USD=
# Sellers audited per UTC day (default 10).
AUDIT_MAX_SELLERS_PER_DAY=
# Audit calls per seller (default 10).
AUDIT_MAX_CALLS_PER_SELLER=

# ---- Scheduled allocation and breadth run ----
# Share of a scheduled run's budget spent on sellers below 30 calls (default 0.7).
COVERAGE_SHARE=
# Time from which coverage tiers are counted (default 2026-10-29T18:00:00Z).
COVERAGE_TIERS_SINCE=
# 30-day inflow in USD above which a seller gets maintenance calls (default 100).
MAINTENANCE_INFLOW_FLOOR_USD=
# 1 = the weekly breadth run may spend (default 0).
BREADTH_RUN_ENABLED=
# Per-call cap for the breadth run (default 0.50).
BREADTH_MAX_PER_CALL_USD=
# Weekly budget for the breadth run (default 10).
BREADTH_WEEKLY_USD=

# ---- Loop (scripts/loop.sh) ----
# Budget per scheduled run (default 1.00).
LOOP_RUN_USD=
# Budget for scheduled buys per UTC day (default 4.00).
LOOP_DAILY_USD=
# Per-call cap for scheduled buys (default 0.10).
LOOP_PER_CALL_USD=
# UTC hours of the scheduled runs, space separated (default "0 6 12 18").
LOOP_RUN_HOURS_UTC=
# UTC hour after which audit triggers and the breadth run are considered (default 12).
LOOP_AUDIT_HOUR_UTC=
# UTC hour of the daily discovery refresh (default 0).
LOOP_REFRESH_HOUR_UTC=
# Weekday of the breadth run, 1 = Monday (default 1).
LOOP_BREADTH_WEEKDAY_UTC=
# Parallel purchases within a run (default 4).
LOOP_BUY_CONCURRENCY=
# Dated operator override: end time (ISO 8601) after which the two values below stop applying.
LOOP_CAP_OVERRIDE_UNTIL_UTC=
# Per-run budget while the override is in force.
LOOP_CAP_OVERRIDE_RUN_USD=
# Daily budget while the override is in force.
LOOP_CAP_OVERRIDE_DAILY_USD=
# 1 = commit and push the export to the public data repo; 0 = export only (default 1).
LOOP_PUBLISH=
# Git URL of the public data repo the export is pushed to.
LOOP_PUBLISH_URL=
# S3 bucket for daily database backups; unset = no backup.
BACKUP_BUCKET=

# ---- Tests and tooling ----
# Path to the anvil binary for the integration suite (default /opt/homebrew/bin/anvil).
ANVIL_BIN=
# Port of the mock seller (default 4402).
PORT=
# Must be 1 to publish @x402-audit/client to npm.
X402_AUDIT_PUBLISH_APPROVED=
