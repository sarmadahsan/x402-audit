{
  "name": "@x402-audit/client",
  "version": "0.1.0",
  "private": false,
  "description": "Opt-in, anonymised outcome telemetry for x402 paid API calls. Drop-in wrapper around @x402/fetch.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "node -e \"if(process.env.X402_AUDIT_PUBLISH_APPROVED!=='1'){console.error('Publishing @x402-audit/client requires explicit human approval (set X402_AUDIT_PUBLISH_APPROVED=1).');process.exit(1)}\" && tsup"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonpath-plus": "^11.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "x402-audit": "workspace:*"
  }
}
